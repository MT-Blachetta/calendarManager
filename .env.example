# Copy to .env (read by docker compose AND by the Spring Boot backend).
# Host port of the dockerized PostgreSQL. 5432 (and 5433, 5434 …) belong to the
# host's default PostgreSQL clusters, so the app uses a separate high port.
CM_DB_HOST=127.0.0.1
CM_DB_PORT=15432
CM_DB_NAME=calendar_manager
CM_DB_USER=calendar
CM_DB_PASSWORD=calendar
# Backend HTTP port
SERVER_PORT=8080
